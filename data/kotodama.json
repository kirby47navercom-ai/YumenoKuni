 "T1-09": {
  "name": "카에데의 증언",
  "text": "",
  "kind": "증언 카드"
 },
 "T1-12": {
  "name": "아이 · 뒷문 미청소",
  "text": "",
  "kind": "증언 카드"
 },
 "T2-01": {
  "name": "호텔 전원의 증언",
  "text": "20:14에 이유 없이 섬뜩했다.",
  "kind": ""
 },
 "T2-02": {
  "name": "사츠키의 증언",
  "text": "19:37쯤 아카리가 '곧 카에데가 올 거야'라고 말했다. 이상했다. 카에데가 오는 걸 어떻게 알지?",
  "kind": ""
 },
 "T2-03": {
  "name": "카에데의 증언",
  "text": "19:38 매점 쪽에 갔지만 아무도 없었다. 그런데 방금까지 누가 있었던 느낌이 들었다.",
  "kind": ""
 },
 "T2-04": {
  "name": "아카리의 증언",
  "text": "저는 19:55부터 호텔 카페에 있었습니다. 되감기는 오늘 쓰지 않았습니다.",
  "kind": ""
 },
 "T2-05": {
  "name": "코토의 증언",
  "text": "나나는 19:30~19:50 저와 정원에 있었어요. 열쇠 소지자는 저·나나·아카리.",
  "kind": "증언 카드"
 },
 "T2-06": {
  "name": "나나의 증언",
  "text": "의무실에 가지 않았어요. 열쇠는 제 가방에.",
  "kind": "증언 카드"
 },
 "T2-07": {
  "name": "하루카의 증언",
  "text": "20:25경 풀 쪽에서 노랫소리가 들렸어. 그 시간까지 살아 있었을 거야.",
  "kind": ""
 },
 "T2-08": {
  "name": "린의 증언",
  "text": "20:30 파도 때 풀에서 사람이 떠 있는 걸 봤어.",
  "kind": ""
 },
 "T2-09": {
  "name": "사츠키의 증언",
  "text": "아카리는 평소와 다르게 말수가 적었다.",
  "kind": ""
 },
 "T2-10": {
  "name": "유우의 약속",
  "text": "유우가 20:30에 풀에서 아카리와 이야기하기로 했다.",
  "kind": "증언 카드"
 },
 "T3-01": {
  "name": "아이의 증언",
  "text": "22:40에 켄을 깨웠어요. …켄이 눈 뜨자마자 '소라는? 소라 어디 갔어?'라고 물었어요.",
  "kind": ""
 },
 "T3-02": {
  "name": "미오의 증언",
  "text": "21:35에 켄이 J열에서 잠든 걸 봤다.",
  "kind": ""
 },
 "T3-03": {
  "name": "레이의 증언",
  "text": "린은 21:55경 후식을 사러 갔다가 22:05에 돌아왔습니다.",
  "kind": ""
 },
 "T3-04": {
  "name": "사츠키의 증언",
  "text": "22:00부터 22:40까지 거울 미로 근처를 순찰. 그림자로 극장을 볼 수 없다.",
  "kind": ""
 },
 "T3-05": {
  "name": "코토·나나·카에데의 증언",
  "text": "21:00~22:40 호텔 라운지. 서로 증인.",
  "kind": ""
 },
 "T3-06": {
  "name": "하루카의 증언",
  "text": "21:50경 화장실 가려고 나가다 보니 J-12(켄 자리)가 비어 있었어. 22:30쯤 돌아와서 보니 자고 있더라.",
  "kind": ""
 },
 "T3-07": {
  "name": "린의 증언",
  "text": "22:05쯤 후식 사러 갔다 와서 음향실 앞을 지나갔는데 문이 닫혀 있었지롱.",
  "kind": ""
 },
 "T3-08": {
  "name": "켄(소라)의 증언",
  "text": "나는 처음부터 끝까지 잠들어 있었어. 소라가 무사했으면 좋겠어.",
  "kind": ""
 },
 "T3-09": {
  "name": "최면 시연 불발",
  "text": "",
  "kind": "증언 카드"
 },
 "T4-01": {
  "name": "코토의 증언",
  "text": "모두의 기억이 일치해요. 505호는 원래 있었어요. 기억이 증거예요.",
  "kind": ""
 },
 "T4-02": {
  "name": "린의 증언",
  "text": "레이와 20:10부터 21:40까지 정비동에서 발전기를 봤지롱!",
  "kind": ""
 },
 "T4-03": {
  "name": "레이의 증언",
  "text": "저는 그 시각 린 씨와 함께 있었습니다.",
  "kind": "증언 카드"
 },
 "T4-04": {
  "name": "카에데의 증언",
  "text": "505호는 내 방 옆이야. 어제까지 있었어.",
  "kind": ""
 },
 "T4-05": {
  "name": "아이의 증언",
  "text": "…505호 청소 담당은 저예요. 어제도 했어요.",
  "kind": ""
 },
 "T4-06": {
  "name": "나나의 증언",
  "text": "하루카 씨가 19시 30분쯤 5층으로 올라갔어요.",
  "kind": ""
 },
 "T4-07": {
  "name": "사츠키의 증언",
  "text": "…505호는 어두웠다. …말이 안 들렸다.",
  "kind": ""
 },
 "T4-08": {
  "name": "미오의 증언",
  "text": "하루카가 '이따 올라갈 일이 있으니 먼저 자'라고 했다.",
  "kind": ""
 },
 "T5-01": {
  "name": "카에데의 증언",
  "text": "22:10에 서고에 들어갔어. 시계는 21:30이었고 내 손목시계는 22:10이었어.",
